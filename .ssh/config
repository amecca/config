#######################
# CERN Network Access #
#######################
Host lxplus
 # Host name
 HostName lxplus.cern.ch

Host lxplus8
 # Host name
 HostName lxplus8.cern.ch

Host lxplus9
 # Host name
 HostName lxplus9.cern.ch

Host lxplus*
 # Username
 User amecca
 # Use SSHv2 only
 Protocol 2
 # Forward your SSH key agent so that it can be used on further hops
 ForwardAgent yes
 # For X11
 ForwardX11 yes
 #ForwardX11Trusted no
 ControlPath /run/user/%i/%r@%h:%p
 ControlMaster auto
 #ControlPersist 1m

############
# LxTunnel #
############

Host lxtunnel*
 HostName lxtunnel.cern.ch
 User amecca
 # Set up a socks proxy on lxtunnel
 DynamicForward 1080
 # Fail if the socks  proxy cannot be set up for some reason.
 ExitOnForwardFailure yes
  # Use anything other than password preferably.
 GSSAPIAuthentication yes
 PubkeyAuthentication yes
 # Do not send credentials where we do not need them.
 # You never need credentials on lxtunnel itself. If used as a jump host they will be 
 # transmitted through.
 GSSAPIDelegateCredentials no
 ForwardAgent no
 # Never use another host as a jump host to lxtunnel. Allways login direct.
 ProxyJump none
 # Ipaddress at CERN move around between different host names so ignore that.
 CheckHostIP no
 # Do not request a shell (equivalent to -N)
 SessionType none
 # Set up a multiplexing connection. Multiple connections will use the first connection
 # with this and so the subsequent connection will require zero authentication.
 # On  a Mac use ControlPath ~/.ssh/%r@%h:%p
 ControlPath /run/user/%i/%r@%h:%p
 ControlMaster auto
 #ControlPersist 1m

######################
# CMS Network Access #
######################

Host cmsusr cmsusr* cmsusr*.cms
 # Username (replace by your cmsusr username if different from your LXPLUS one)
 User amecca
 # Use SSHv2 only
 Protocol 2
 # Forward your SSH key agent so that it can be used on further hops
 ForwardAgent yes
 # For X11
 ForwardX11 yes
 #ForwardX11Trusted no

 # Go through lxplus so that it works from wherever you are
 ProxyCommand ssh lxplus nc %h 22
 # ProxyJump lxtunnel.cern.ch

 # Setup a SOCKS5 proxy on local port 1080 so that you can easily browse internal CMS web sites
 DynamicForward 1080

 # DAQ OnCall settings (DB and daqweb)
 # For connection to the DB, from outside use the tnsnames.ora file provided where this file was provided
 LocalForward 10121 cmsonr1-v.cms:10121
 #LocalForward 10122 cmsonr2-v.cms:10121
 #LocalForward 10123 cmsonr3-v.cms:10121
 #LocalForward 10124 cmsonr4-v.cms:10121
 #LocalForward 10125 cmsintr1-v.cms:10121
 #LocalForward 10126 cmsintr2-v.cms:10121
 #LocalForward 45679 cmsdaqweb.cms:45679

Host hilton*
 User amecca
 Protocol 2
 ProxyJump cmsusr 


##################
# FNAL OSG nodes #
##################

Host cmslpc*.fnal.gov
    GSSAPIAuthentication yes
    GSSAPIDelegateCredentials yes
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    #
    # Note: uncomment in case of "WARNING: REMOTE HOST IDENTIFICATION HAS CHANGED!"
    #GSSAPITrustDNS yes
    #
    # Note: In case your ssh connection keeps timing out
    #ServerAliveInterval 60
    #TCPKeepAlive yes
    #KeepAlive yes
# Info: https://uscms.org/uscms_at_work/physics/computing/getstarted/uaf.shtml

